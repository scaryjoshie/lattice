{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "error", "useConst": "error", "noParameterAssign": "error" },
      "suspicious": { "noExplicitAny": "error", "noConsole": "off" },
      "correctness": { "useExhaustiveDependencies": "warn" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "files": { "includes": ["packages/**", "scripts/**", "!**/node_modules", "!**/dist"] }
}
